# IANA time zone of the meeting room. "Today" and "past" are computed in this zone on both client and server.
NEXT_PUBLIC_ROOM_TIME_ZONE=Asia/Bishkek
# Enables demo helpers: "occupy as colleague" (reproduces 409) and data reset.
NEXT_PUBLIC_DEMO_TOOLS=true
# Artificial API latency range in ms, e.g. "300-800". Empty or 0 disables it.
DEMO_LATENCY_MS=300-800
