# Meeting-room booking demo (test task). Served by container booking-app on the edge network.
# Not for indexing: it is a demo with resettable in-memory data.
booking.sydykov.com {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip

	# Booking payloads are tiny; refuse large bodies before they reach Node.
	request_body {
		max_size 16KB
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy booking-app:3000
}
